s": ["如玉：安同，你跟我一起去臺南玩，好嗎？\n安同：好啊。妳想怎麼去？\n如玉：我要坐火車去。\n安同：坐高鐵比較快啊！\n如玉：我知道坐高鐵比較快，但是太貴了！\n安同：我也覺得，可是坐高鐵又快又舒服。\n如玉：坐火車比較便宜，也可以看風景。\n安同：好，我們坐火車去。"], "qs": [{"n": 1, "q": "如玉想坐火車去臺南。", "a": "O（對）", "b": "X（錯）", "c": "", "d": "", "ans": "A"}, {"n": 2, "q": "安同不覺得高鐵票很貴。", "a": "O（對）", "b": "X（錯）", "c": "", "d": "", "ans": "B"}, {"n": 3, "q": "如玉覺得坐高鐵快可是貴。", "a": "O（對）", "b": "X（錯）", "c": "", "d": "", "ans": "A"}, {"n": 4, "q": "坐火車又便宜又可以看風景。", "a": "O（對）", "b": "X（錯）", "c": "", "d": "", "ans": "A"}, {"n": 5, "q": "他們坐高鐵去臺南。", "a": "O（對）", "b": "X（錯）", "c": "", "d": "", "ans": "B"}]}, "g7": {"groups": [{"k": "A", "title": "VI. Fill in the Blanks 填空", "arrow": "", "items": [{"n": "1", "pattern": "", "q": "明天晚上我想＿＿朋友去看電影。", "ans": "跟", "img": ""}, {"n": "2", "pattern": "", "q": "A：他跟不跟你去KTV唱歌？ B：他＿＿我去，他跟同學去。", "ans": "不跟", "img": ""}, {"n": "3", "pattern": "", "q": "我家附近的餐廳，＿＿便宜＿＿好吃，我常＿＿家人去吃。", "ans": "又；又；跟", "img": ""}, {"n": "4", "pattern": "", "q": "A：今天很熱！ B：我覺得昨天＿＿熱。", "ans": "比較", "img": ""}, {"n": "5", "pattern": "", "q": "A：你知道＿＿去故宮嗎？ B：你可以坐公車去。", "ans": "怎麼", "img": ""}]}]}, "ord": [{"n": 1, "toks": ["想", "高鐵", "臺南", "去", "我", "坐", "玩"], "ans": "我想坐高鐵去臺南玩。"}, {"n": 2, "toks": ["他", "去看", "跟", "不", "比賽", "棒球", "我"], "ans": "他不跟我去看棒球比賽。"}, {"n": 3, "toks": ["那家", "牛肉麵", "比較", "店", "好吃", "的"], "ans": "那家店的牛肉麵比較好吃。"}, {"n": 4, "toks": ["網路上", "可以", "在", "買", "票", "高鐵", "你"], "ans": "你可以在網路上買高鐵票。"}, {"n": 5, "toks": ["中國", "東西", "很多", "有", "故宮", "的", "古代"], "ans": "故宮有很多中國古代的東西。"}], "hz": [{"n": 1, "lines": [{"sp": "", "py": "Zuò huǒchē yǒu yìdiǎn màn.", "ans": "坐火車有一點慢。"}]}, {"n": 2, "lines": [{"sp": "", "py": "Tīngshuō gāotiě chēpiào fēicháng guì.", "ans": "聽說高鐵車票非常貴。"}]}, {"n": 3, "lines": [{"sp": "", "py": "Zuò jìchéngchē yòu kuài yòu shūfú.", "ans": "坐計程車又快又舒服。"}]}, {"n": 4, "lines": [{"sp": "", "py": "Tóngxué qí jīchē zài wǒ qù jiéyùnzhàn.", "ans": "同學騎機車載我去捷運站。"}]}, {"n": 5, "lines": [{"sp": "", "py": "Qí jīchē bǐ zuò gōngchē kuài ma?", "ans": "騎機車比坐公車快嗎？"}]}], "dlg": [{"i": "1", "sp": "", "text": "A：你想跟我去圖書館看書嗎？ B：＿＿＿＿。", "ans": "好啊，我跟你一起去"}, {"i": "2", "sp": "", "text": "A：＿＿＿＿？ B：我比較喜歡喝烏龍茶。", "ans": "你比較喜歡喝咖啡還是烏龍茶"}, {"i": "3", "sp": "", "text": "A：為什麼你常坐高鐵？ B：＿＿＿＿。", "ans": "因為坐高鐵又快又舒服"}, {"i": "4", "sp": "", "text": "A：你們學校比他們學校遠嗎？ B：＿＿＿＿。", "ans": "沒有，差不多"}, {"i": "5", "sp": "", "text": "A：你為什麼不跟他去看電影？ B：＿＿＿＿。", "ans": "因為我沒有空"}], "pic": [{"n": "1", "hint": "人物騎機車前往故宮", "ans": "朋友騎機車載我去故宮。", "img": ""}, {"n": "2", "hint": "標示「明天」的海邊風景", "ans": "明天我們要去海邊玩。", "img": ""}, {"n": "3", "hint": "電腦、高鐵與便利商店", "ans": "我可以在網路上買高鐵票。", "img": ""}, {"n": "4", "hint": "火車票、高鐵票與兩種列車", "ans": "坐高鐵比坐火車快。", "img": ""}], "write": {"title": "XI. Composition (60 characters) 作文", "intro": "這個週末你要去哪裡玩？", "points": [], "words": []}}}}